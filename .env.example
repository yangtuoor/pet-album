# 复制成 .env 后填自己的值，这个文件本身不要提交
PET_PORT=8899
PET_HOST=0.0.0.0
PET_DATA_DIR=./data
PET_ADMIN_PASSWORD=change-me-please
PET_ADMIN_PATH=admin
PET_TRUST_PROXY=0
PET_IMAGE_MAX_BYTES=2097152

# 可选：Cloudflare R2。不填就存本地 data/media/
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE=
R2_REGION=auto
